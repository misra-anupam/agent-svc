# Preset: protections on (JWT, Redis limits/cache, server-side memory). Set AGENT_AUTH__SECRET separately.
AGENT_AUTH__ENABLED=true
AGENT_RATELIMIT__PROVIDER=redis
AGENT_CACHE__PROVIDER=redis
AGENT_MEMORY__THREAD_PROVIDER=redis
AGENT_MEMORY__USER_PROVIDER=postgres
AGENT_MEMORY__LONG_TERM_PROVIDER=pgvector
AGENT_POSTGRES__ENABLED=true
AGENT_APP__RUN_BUFFER=redis
AGENT_APP__DETACH_ON_DISCONNECT=true

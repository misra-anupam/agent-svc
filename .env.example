# Copy to .env. Nested keys use "__". See docs for every option.
AGENT_APP__ENVIRONMENT=local
AGENT_APP__AGENT_VERSION=1.0.0
AGENT_ORCHESTRATOR__PROVIDER=langgraph
# OPENROUTER_API_KEY=sk-or-...                 # read by LiteLLM, not AGENT_-prefixed
AGENT_REDIS__URL=redis://localhost:6379/0
AGENT_LLM__PRIMARY_MODEL=openrouter/anthropic/claude-sonnet-4.5
# AGENT_LLM__SECONDARY_MODEL=openai/gpt-4o
AGENT_AUTH__ENABLED=false
# AGENT_AUTH__SECRET=change-me
AGENT_TRACING__OTLP_ENDPOINT=http://localhost:4318

# --- Phase 3: state & protection (all optional) ---
# AGENT_AUTH__ENABLED=true
# AGENT_AUTH__SECRET=<32+ random bytes>        # HS256; or ALGORITHM=RS256 + PUBLIC_KEY / JWKS_URL
# AGENT_RATELIMIT__PROVIDER=redis              # none | redis
# AGENT_RATELIMIT__MODE=reject                 # reject | throttle
# AGENT_CACHE__PROVIDER=redis                  # none | redis
# AGENT_CACHE__SCOPE=user                      # user | tenant | global
# AGENT_MEMORY__THREAD_PROVIDER=redis          # none (stateless) | inmemory | redis
AGENT_MEMORY__USER_PROVIDER=postgres           # none | inmemory | postgres (default; needs Postgres)
# AGENT_MEMORY__LONG_TERM_PROVIDER=pgvector    # none | inmemory | pgvector
AGENT_POSTGRES__ENABLED=true
# AGENT_POSTGRES__DSN=postgresql://agent:agent@localhost:5432/agent
# AGENT_APP__RUN_BUFFER=redis                  # inmemory | redis  (needed for multi-replica resume)
# AGENT_APP__DETACH_ON_DISCONNECT=true         # keep runs alive after disconnect so clients can resume
# AGENT_APP__TRUSTED_PROXY_HOPS=1              # behind N reverse proxies

# --- Phase 4: observability (OpenTelemetry by default; uv sync --extra otel) ---
# AGENT_TRACING__PROVIDER=otel                 # otel | mlflow
# AGENT_TRACING__OTLP_ENDPOINT=http://otel-collector:4318
# AGENT_TRACING__OTLP_HEADERS={"x-api-key":"..."}   # for hosted backends
# AGENT_TRACING__SAMPLE_RATIO=1.0
# AGENT_METRICS__ENABLED=true                  # OTel metrics over the same OTLP endpoint
# AGENT_METRICS__EXPORT_INTERVAL_SECONDS=15
# AGENT_TRACING__MLFLOW_TRACKING_URI=http://mlflow:5000   # only when provider=mlflow
# AGENT_TRACING__CAPTURE_CONTENT=false         # true records prompts/answers in traces (PII risk)

# Tools / MCP (JSON for lists). HTTP MCP hosts must be allow-listed (SSRF guard).
AGENT_TOOLS__LOCAL=["calculator","current_time"]
# AGENT_MCP__SERVERS=[{"name":"demo","transport":"streamable_http","url":"http://mcp-demo:8080/mcp"}]
# AGENT_MCP__ALLOWED_HOSTS=["mcp-demo"]
# Orchestrator: langgraph (install the matching uv extra)

# Guardrails. Rail: builtin (add your own via `make new-adapter PORT=guardrails`)
# AGENT_GUARDRAILS__FAIL_MODE=closed        # a broken rail blocks (closed) or is skipped (open)
# AGENT_GUARDRAILS__OUTPUT_MODE=buffer      # buffer | stream
# AGENT_GUARDRAILS__TIER_POLICY={"internal":{"enabled":false}}

# Prompt store + evaluation
# AGENT_PROMPTS__MLFLOW_TRACKING_URI=http://mlflow:5000   # prompts come from the MLflow registry
# AGENT_PROMPTS__REF=system@prod            # name@alias | name:version | name  (empty = built-in prompt)
# AGENT_EVALUATION__PROVIDER=mlflow_genai   # make eval (sqlite store under evals/.mlflow)

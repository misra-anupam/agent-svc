[importlinter]
root_package = agent_svc
include_external_packages = True

[importlinter:contract:layers]
name = Hexagonal layers (api > application > domain)
type = layers
layers =
    agent_svc.api
    agent_svc.application
    agent_svc.domain

[importlinter:contract:no-adapters-in-inner-layers]
name = api and application never import concrete adapters
type = forbidden
source_modules =
    agent_svc.api
    agent_svc.application
forbidden_modules =
    agent_svc.adapters

[importlinter:contract:pure-domain]
name = domain stays framework-free
type = forbidden
source_modules =
    agent_svc.domain
forbidden_modules =
    fastapi
    pydantic
    redis
    asyncpg
    structlog
    agent_svc.adapters
    agent_svc.api
    agent_svc.application
